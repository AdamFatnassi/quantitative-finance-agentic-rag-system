# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure your local credentials
# ==============================================================================

# ── TimescaleDB / PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=quant_db
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5433/quant_db

# ── Vector Database (Qdrant) ──────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
RAG_QDRANT_COLLECTION=financial_text_chunks
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# ── Data Provider APIs ────────────────────────────────────────────────────────
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
SEC_USER_AGENT=YourNameOrFund yourname@domain.com

# ── LLM Gatekeeper Providers (Ollama / OpenAI) ───────────────────────────────
GATEKEEPER_LLM_PROVIDER=ollama
GATEKEEPER_LLM_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Optional: If using OpenAI instead of local Ollama
OPENAI_API_KEY=your_openai_api_key_here

# ── Gatekeeper Hyperparameters ────────────────────────────────────────────────
GATEKEEPER_LLM_TEMPERATURE=0.0
GATEKEEPER_LLM_TOP_P=0.9
GATEKEEPER_LLM_NUM_CTX=2048
GATEKEEPER_LLM_MAX_TOKENS=512
GATEKEEPER_MAX_CONCURRENCY=10
GATEKEEPER_ERROR_FALLBACK=GO
